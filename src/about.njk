---
title: About — Boston Dialogue Foundation
layout: base.njk
permalink: /about/index.html
---
<div class="page-hero">
  <h1>About Us</h1>
  <p>Serving Greater Boston since {{ settings.since }}</p>
</div>

<div class="wrap">
  <section>
    <div class="section-head">
      <p class="eyebrow">Mission</p>
      <h2>Why We Exist</h2>
    </div>
    <div class="three-col" style="grid-template-columns: 1fr;">
      <div class="card">
        {% for p in about.mission %}<p>{{ p }}</p>{% endfor %}
      </div>
    </div>
  </section>

  <section>
    <div class="section-head">
      <p class="eyebrow">Vision</p>
      <h2>What We're Building Toward</h2>
    </div>
    <div class="three-col" style="grid-template-columns: 1fr;">
      <div class="card">
        {% for p in about.vision %}<p>{{ p }}</p>{% endfor %}
      </div>
    </div>
  </section>

  <section>
    <div class="section-head">
      <p class="eyebrow">Goals</p>
      <h2>How We Get There</h2>
    </div>
    <ul class="goals-list">
      {% for g in about.goals %}
      <li><span class="num">{{ loop.index }}</span><span>{{ g }}</span></li>
      {% endfor %}
    </ul>
  </section>

  <section id="focus-areas">
    <div class="section-head">
      <p class="eyebrow">Our work</p>
      <h2>Six Areas of Focus</h2>
    </div>
    <div class="tiles">
      {% for area in settings.focusAreas %}
      <div class="tile"><h4>{{ area.name }}</h4></div>
      {% endfor %}
    </div>
  </section>
</div>
